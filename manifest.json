{
    "manifest_version": 3,
    "name": "Return to Left Tab",
    "version": "1.0",
    "description": "Tab Position Options",
    "background": {
      "service_worker": "background.js"
    },
    "permissions": [
      "storage",
      "tabs"
    ],
    "icons": {
       "128": "icon128.png",
       "16": "icon16.png",
       "32": "icon32.png",
       "48": "icon48.png"
    }
}